# =============================================================================
# Nexus Gaming Review Platform - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
#   cp .env.example .env.local
#
# .env.local is git-ignored and will NOT be committed.
# =============================================================================

# ---------- JWT ----------
# Secret used to sign and verify authentication tokens.
# Must be at least 32 characters. Use a random hex string (64 chars recommended).
# REQUIRED in production — the app will refuse to start without it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ---------- Admin Account ----------
# Credentials for the default admin user seeded on first run.
# In production all three MUST be set; in development safe defaults are used.
ADMIN_EMAIL=admin@enterprise.gg
ADMIN_USERNAME=NexusAdmin
ADMIN_PASSWORD=

# ---------- Sentry (optional) ----------
# Server-side Sentry DSN for error tracking.
SENTRY_DSN=
# Client-side (browser) Sentry DSN. Prefixed with NEXT_PUBLIC_ so Next.js
# exposes it to the browser bundle.
NEXT_PUBLIC_SENTRY_DSN=
