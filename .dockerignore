# Dependencies — installed fresh inside the container
node_modules

# Next.js build output — rebuilt inside the container
.next

# Git history is not needed in the image
.git

# Local environment files contain secrets — never bake into an image
.env*.local

# Local database file
data/nexus-db.json

# Test coverage reports
coverage

# GitHub Actions workflows are not needed at runtime
.github

# Markdown docs (except README which may be useful for reference)
*.md
!README.md

# Docker files themselves
Dockerfile
.dockerignore
